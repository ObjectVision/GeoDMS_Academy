container basic_analyses_vector_exercise
{
	container Units
	{
		unit<float64> m   := baseunit('m', float64);   // metre, the metric of the RD New coordinates; float64 like the dpoint coordinates
		unit<float64> m2  := m * m;
		unit<float64> km2 := 1000000.0 * m2;
	}

	container Geography
	{
		unit<dpoint> rdc_base : SpatialReference = "EPSG:28992", DialogData = "wmts_layer";                   // Rijksdriehoekstelsel (RD New), with float64 coordinates (dpoint): the geos_ functions work on dpoint
		unit<dpoint> rdc      := range(rdc_base, point_xy(0.0, 300000.0), point_xy(280000.0, 625000.0)); // the 2D range of the Netherlands in RD New

		#include <../wmts_layer.dms>
	}

	container SourceData
	{
		unit<uint32> gemeente                                                  // the source data of Module 2A, read from the data folder of data_sources
		:	StorageName     = "%ProjDir%/../data_sources/data/gemeente.csv"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True";

		unit<uint32> NS_station
		:	StorageName     = "%ProjDir%/../data_sources/data/NS_stations_2019_RD.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Geography/rdc> geometry;                                 // points; the file also holds stations abroad
		}

		unit<uint32> motorway
		:	StorageName     = "%ProjDir%/../data_sources/data/OSM_Motorways_NL.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Geography/rdc> geometry (arc);
		}

		unit<uint32> Corop
		:	StorageName     = "%ProjDir%/../data_sources/data/CBS_COROP_2012.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Geography/rdc> geometry (polygon);
		}

		unit<spoint> BBG
		:	StorageName     = "%ProjDir%/../data_sources/data/bbg2015_100m_10k.tif"
		,	StorageType     = "gdal.grid"
		,	StorageReadOnly = "True"
		,	DialogData      = "/Geography/rdc"
		{
			attribute<uint8> GridData;
		}

		unit<uint32> province                                                  // the twelve provinces, the shapefile of Module 1
		:	StorageName     = "%ProjDir%/../basics_single_domain/data/provincie.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Geography/rdc> geometry (polygon);
			attribute<string>        naam;
		}

		unit<uint32> pc4_points                                                // the centre point of each four-digit postcode area, taken from basics_multiple_domains/data/pc4_xy_tm2020.shp
		:	StorageName     = "%ProjDir%/data/pc4_points.csv"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<string>  postcode;
			attribute<float64> x_rd;
			attribute<float64> y_rd;
		}
	}

	container Analysis: using = "Units;Geography;SourceData"  // room to try the code examples of the wiki page
	{
	}

	container Exercises: using = "Units;Geography;SourceData" // room for your answers to the exercises
	{
	}
}
