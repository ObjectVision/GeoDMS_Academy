container data_sources_result
{
	container Geography
	{
		unit<fpoint> rdc_base : SpatialReference = "EPSG:28992"	,	DialogData = "wmts_layer";                // Rijksdriehoekstelsel, a 2D cartesian coordinate system for the netherlands
		unit<fpoint> rdc      := range(rdc_base, point_xy(0f, 300000f), point_xy(280000f, 625000f));  // Define a 2D range consisting of 2D cartesian coordinates, used as values unit of the geometry attributes in SourceData
	
		#include <../wmts_layer.dms>
	}

	container SourceData
	{
		unit<uint32> gemeente                                // create a domain unit of uint32 = 2^32 = 4294967296 max rows, actual number of rows based on the gemeente.csv file
		:	StorageName     = "%ProjDir%/Data/gemeente.csv"  // Location of file to be read by the storagemanager
		,	StorageType     = "gdal.vect"                    // Use the gdal.vect storage manager
		,	StorageReadOnly = "True";                        // We will not be editing the underlying datafile

		unit<uint32> NS_station                              
		:	StorageName     = "%ProjDir%/Data/NS_stations_2019_RD.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Geography/rdc> geometry; // Default read as points
		}

		unit<uint32> motorway                               
		:	StorageName     = "%ProjDir%/Data/OSM_Motorways_NL.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Geography/rdc> geometry (arc); // The geometry consists of arcs, (arc) gives GeoDMS instructions for interpreting the geometry
		}

		unit<uint32> Corop                                  
		:	StorageName     = "%ProjDir%/Data/CBS_COROP_2012.shp"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True"
		{
			attribute<Geography/rdc> geometry (polygon); // The geometry consists of polygons, (polygon) or (poly) gives GeoDMS instructions for interpreting the geometry
		}

		unit<spoint> BBG
		:	StorageName     = "%ProjDir%/Data/bbg2015_100m_10k.tif"
		,	StorageType     = "gdal.grid"                           // In contrast to the other dataitems, this one consists of a raster (GeoTiff). Hence use the gdal.grid storage manager
		,	StorageReadOnly = "True"
		,	DialogData      = "/Geography/rdc"                      // Coordinate system to interpret the Tiff World File (.tfw) specified upper left coordinate and steps in east and north direction.
		{
			attribute<uint8> GridData;                              // We know the tiff contains uint8 values for each rastercell, specified <uint8> to read correctly.
		}
	}

	container Export
	{
		unit<uint32> NS_stations := SourceData/NS_station                  // Module 2B: the train stations as a new shapefile
		,	StorageName = "%LocalDataProjDir%/NS_stations_export.shp"
		,	StorageType = "gdalwrite.vect"
		{
			attribute<Geography/rdc> geometry := SourceData/NS_station/geometry;
			attribute<string>        naam     := SourceData/NS_station/Webnaam;
		}

		unit<uint32> gemeente_export := SourceData/gemeente                // Module 2D: the municipalities as a parquet file for Python
		,	StorageName     = "%LocalDataProjDir%/python/gemeente.parquet"
		,	StorageType     = "gdalwrite.vect"
		,	StorageReadOnly = "False"
		{
			attribute<string> GM_CODE  := SourceData/gemeente/GM_CODE;
			attribute<string> GM_NAAM  := SourceData/gemeente/GM_NAAM;
			attribute<int32>  AANT_INW := SourceData/gemeente/AANT_INW[int32]; // the csv column is read as string
		}
	}

	container Preprocessing                                                // Module 2C: write the source data once to MMD
	{
		unit<uint32> gemeente := SourceData/gemeente                       // the csv has no geometry
		,	StorageName = "%LocalDataProjDir%/gemeente.mmd"
		{
			attribute<string> GM_CODE  := SourceData/gemeente/GM_CODE;
			attribute<int32>  AANT_INW := SourceData/gemeente/AANT_INW[int32];
		}

		unit<uint32> Corop := SourceData/Corop                             // the shapefile has no numeric attribute, so the area is calculated
		,	StorageName = "%LocalDataProjDir%/corop.mmd"
		{
			attribute<Geography/rdc> geometry (poly) := SourceData/Corop/geometry;
			attribute<string>        statnaam        := SourceData/Corop/statnaam;
			attribute<float32>       area_km2        := area(SourceData/Corop/geometry, float32) / 1000000f;
		}
	}

	container Model                                                        // Module 2C: read the MMD files back instead of the source files
	{
		unit<uint32> gemeente                                              // the attributes are declared by the file itself
		:	StorageName     = "%LocalDataProjDir%/gemeente.mmd"
		,	StorageReadOnly = "True";

		unit<uint32> Corop
		:	StorageName     = "%LocalDataProjDir%/corop.mmd"
		,	StorageReadOnly = "True";

		parameter<bool> gemeente_identical :=                              // true if each row read back equals the row of the csv
			   all(union_data(SourceData/gemeente, gemeente/GM_CODE) == SourceData/gemeente/GM_CODE)
			&& all(union_data(SourceData/gemeente, gemeente/AANT_INW) == SourceData/gemeente/AANT_INW[int32]);
		parameter<bool> Corop_identical :=                                 // true if each region read back has the name and the area of the shapefile
			   all(union_data(SourceData/Corop, Corop/statnaam) == SourceData/Corop/statnaam)
			&& all(union_data(SourceData/Corop, area(Corop/geometry, float32)) == area(SourceData/Corop/geometry, float32));
	}

	container FromPython                                                   // Module 2D: read back what the script python/gemeente_share.py wrote
	{
		unit<uint32> gemeente_python
		:	StorageName     = "%LocalDataProjDir%/python/gemeente_python.parquet"
		,	StorageType     = "gdal.vect"
		,	StorageReadOnly = "True";

		attribute<gemeente_python> py_rel    (SourceData/gemeente) := rlookup(SourceData/gemeente/GM_CODE, gemeente_python/GM_CODE); // the script filtered rows, so relate on the code
		attribute<float64>         INW_SHARE (SourceData/gemeente) := py_rel -> INW_SHARE;
	}
}
