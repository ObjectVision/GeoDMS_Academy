container GeoDMS_Academy_MetaScripting
{ 
	container Units
	{
		unit<float32> m  := BaseUnit('m', float32);
		unit<float32> m2 := m * m;
		unit<Float32> ha := 10000.0 * m2, Label = "Hectare";
	}

	#include <Geography.dms>
	
	container Classifications
	{
		unit<uint8> lu_class : nrofrows = 4
		{
			attribute<string>  Label       : ['absent (< 5%)', 'low (5-25%)', 'medium (25-60%)', 'high (> 60%)'];
			attribute<float32> ClassBreaks : [0.0, 0.05, 0.25, 0.60], DialogType = "Classification";
			attribute<uint32>  BrushColor  : [rgb(220,220,220), rgb(180,225,180),rgb(80,180,80),rgb(0,100,0)], DialogType = "BrushColor";
		}
		
		unit<uint32> LandUseTypes : nrofrows = 3
		{
			attribute<string> name  : ['residential', 'agriculture', 'nature'];
			attribute<string> label := name;
		}
	}
	
	container SourceData 
	: using = "geography"
	{
		unit<uint32> Regions 
		: StorageName = "%ProjDir%/data/CBS_COROP_2012.shp"
		, StorageType = "gdal.vect"
		, StorageReadOnly = "true"
		, DialogData = "rdc_meter"
		{
			attribute<.> per_rdc_100m (rdc_100m) := poly2grid(geometry, rdc_100m);
		}

		container LandUse // steps 1 and 2: the land-use fractions that the three case instantiations get as argument
		{
			attribute<float32> residential (rdc_100m)
			: StorageName = "%ProjDir%/data/share_lu_2017_residential.tif"
			, StorageType = "tif"
			, StorageReadOnly = "true";

			attribute<float32> nature (rdc_100m)
			: StorageName = "%ProjDir%/data/share_lu_2017_nature.tif"
			, StorageType = "tif"
			, StorageReadOnly = "true";

			attribute<float32> agriculture (rdc_100m)
			: StorageName = "%ProjDir%/data/share_lu_2017_agriculture.tif"
			, StorageType = "tif"
			, StorageReadOnly = "true";
		}
	}

	// steps 1 and 2: a template with the land-use fraction as case parameter, and a case instantiation per land-use type
	template LandUse_T : using = "units;geography;sourcedata;Classifications"
	{
		//begin case parameters
		attribute<float32> lu_fraction (rdc_100m);
		//end case parameters

		attribute<ha>       surface_ha              (rdc_100m) := lu_fraction * rdc_100m/NrHaPerCell;
		attribute<bool>     IsDominant              (rdc_100m) := lu_fraction > 0.5f;
		attribute<lu_class> class_rel               (rdc_100m) := classify(lu_fraction, lu_class/ClassBreaks);
		attribute<float32>  mean_fraction_per_region (Regions) := mean(lu_fraction, Regions/per_rdc_100m);
	}

	container residential := LandUse_T(SourceData/LandUse/residential);
	container nature      := LandUse_T(SourceData/LandUse/nature);
	container agriculture := LandUse_T(SourceData/LandUse/agriculture);

	// step 3: a case per land-use type in Classifications/LandUseTypes, made with for_each; the template builds the file name from its case parameter
	container per_LandUseType :=
		for_each_ne(
			Classifications/LandUseTypes/name
			, 'per_LandUseType_T('+quote(Classifications/LandUseTypes/name)+')'
		);

	template per_LandUseType_T : using = "units;geography;sourcedata;Classifications"
	{
		//begin case parameters
		parameter<string> LUT_name;
		//end case parameters

		attribute<float32> lu_fraction (rdc_100m)
		: StorageName = "='%ProjDir%/data/share_lu_2017_'+LUT_name+'.tif'"
		, StorageType = "tif"
		, StorageReadOnly = "true";
		
		attribute<ha>       surface_ha              (rdc_100m) := lu_fraction * rdc_100m/NrHaPerCell;
		attribute<bool>     IsDominant              (rdc_100m) := lu_fraction > 0.5f;
		attribute<lu_class> class_rel               (rdc_100m) := classify(lu_fraction, lu_class/ClassBreaks);
		attribute<float32>  mean_fraction_per_region (Regions) := mean(lu_fraction, Regions/per_rdc_100m);
	}
}