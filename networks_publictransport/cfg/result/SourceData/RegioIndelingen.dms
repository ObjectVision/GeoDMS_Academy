container RegioIndelingen : using = "geometries"
{
	unit<uint32> PC4_punten
	:	StorageName     = "=ModelParameters/SourceDataFolder+'/pc4_xy_tm2020.gpkg'"
	,	StorageType = "gdal.vect"
	, 	storagereadOnly = "true"
	,	SyncMode = "none"
	{
		attribute<rdc>                  geometry;
		attribute<string>               label;
		attribute<string>               name                          := label;
		attribute<bool>                 IsSA                          := IsDefined(point_in_polygon(geometry, Provincies/sub/geometry));
		
		unit<uint32> sub := select_with_org_rel(IsSA)
		{
			attribute<rdc>                  geometry                      := ../geometry[org_rel];
			attribute<rdc>                  point                         := geometry;
			attribute<string>               name                          := ../name[org_rel];
			attribute<string>               label                         := name, DialogType = "LabelText";
		}
	}
	
	unit<uint32> Provincies
	:	StorageName     = "=ModelParameters/SourceDataFolder+'/Provinciegrenzen_2019.gml'"
	,	StorageType     = "gdal.vect"
	,	StorageReadOnly = "True"
	,	SyncMode = "none"
	{
		attribute<geometries/rdc>       geometry (poly);
		attribute<string>               provincienaam;
		attribute<string>               name           := AsItemName(provincienaam);
		attribute<string>               label          := provincienaam;
		
		unit<uint32> sub := select_with_org_rel(name == 'Noord_Holland')
		{
			attribute<geometries/rdc>       geometry (poly) := ../geometry[org_rel];
			attribute<string>               name            := ../name[org_rel];
			attribute<string>               label           := ../label[org_rel];
		}
	
	}

}
